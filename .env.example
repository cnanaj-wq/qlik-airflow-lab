# Copiez ce fichier en .env (exclu de Git) puis remplissez-le VOUS-MÊME.
# Ne collez jamais la clé dans un ticket, un commit, une capture ou une conversation.

# --- Qlik Cloud (réel) ---------------------------------------------------------
# URL de base du tenant, sans chemin : https://<alias>.<région>.qlikcloud.com
QLIK_TENANT_URL=https://votre-alias.fr.qlikcloud.com
# Clé API (JWT). Expire le 12/12/2026 : renouvellement à prévoir (docs/GUIDE-AIRFLOW.md, § Secrets).
QLIK_API_KEY=
# Optionnel : espace partagé cible. Vide = espace personnel.
QLIK_SPACE_ID=
# Optionnel : préfixe des noms d'app (ex. DEV_) pour séparer un environnement de dev.
QLIK_APP_PREFIX=

# --- Greffe sur l'Airflow 3 existant (C:\airflow) ------------------------------
# Chemin de ce dépôt, vu par Docker (barres obliques).
QLIK_LAB_DIR=C:/qlik-airflow-lab
# Base Postgres de supervision des reloads (port local, 127.0.0.1 uniquement).
QLIK_SUPERVISION_PORT=5434
# Obligatoire : choisissez un mot de passe (jamais commité). Il ne s'applique qu'à la
# création de la base ; ensuite, changez-le aussi dans Postgres (ALTER USER).
QLIK_SUPERVISION_PASSWORD=
