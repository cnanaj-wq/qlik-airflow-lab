{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "CI/CD des scripts Qlik : du commit à l'app rechargée",
    "output": "docs/cicd.html",
    "quality_profile": "showcase",
    "visual_preset": "signal-flow",
    "views": [
      {
        "id": "ci",
        "label": "01 / CI",
        "focus": [
          "push",
          "tests",
          "gate",
          "prend",
          "cifail"
        ],
        "note": "Chaque PR et chaque push sur main passent les contrôles. Une PR s'arrête là : elle n'a pas accès aux secrets."
      },
      {
        "id": "cd",
        "label": "02 / CD Qlik",
        "focus": [
          "gate",
          "env",
          "deploy",
          "apps"
        ],
        "note": "Sur main seulement : approbation de l'environnement qlik-cloud, puis scripts poussés par l'API Qlik Cloud."
      },
      {
        "id": "rollback",
        "label": "03 / Reprise CD",
        "focus": [
          "deploy",
          "apps",
          "rollback"
        ],
        "note": "Une régression se reprend par git revert : le CD repousse la version précédente, Qlik garde l'historique des scripts."
      }
    ]
  },
  "lanes": [
    {
      "id": "ci",
      "label": "CI — intégration continue"
    },
    {
      "id": "cd",
      "label": "CD — déploiement continu"
    },
    {
      "id": "target",
      "label": "Cible — Qlik Cloud (réel)"
