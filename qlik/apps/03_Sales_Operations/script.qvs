///$tab Main
// =============================================================================
// 03_Sales_Operations — app de PILOTAGE (consommateurs métier)
// Rôle : charger les QVD transformés (lecture optimisée), formats français, expressions
// centralisées. Rechargée par Airflow SEULEMENT si la porte qualité est verte : sinon les
// utilisateurs gardent les chiffres de la veille, justes, plutôt que des chiffres faux.
// Pas de Section Access dans ce lab (hors périmètre).
// =============================================================================
SET ThousandSep=' ';
SET DecimalSep=',';
SET MoneyThousandSep=' ';
SET MoneyDecimalSep=',';
SET MoneyFormat='# ##0,00 €;-# ##0,00 €';
SET TimeFormat='hh:mm:ss';
SET DateFormat='DD/MM/YYYY';
SET TimestampFormat='DD/MM/YYYY hh:mm:ss';
SET FirstWeekDay=0;
SET BrokenWeeks=0;
SET ReferenceDay=4;
SET FirstMonthOfYear=1;
SET CollationLocale='fr-FR';
SET MonthNames='janv.;févr.;mars;avr.;mai;juin;juil.;août;sept.;oct.;nov.;déc.';
SET DayNames='lun.;mar.;mer.;jeu.;ven.;sam.;dim.';
SET ErrorMode=1;

SET vLib = 'lib://DataFiles/';
SET vQvdTrf = 'qal_trf_';

LET vRunId = If(Len('$(vRunId)') > 0, '$(vRunId)', 'manuel-' & Timestamp(Now(1), 'YYYYMMDDhhmmss'));
TRACE Run $(vRunId) — script $(vScriptVersion);

///$tab Model
// Chargements sans transformation = lectures QVD « optimisées » (les plus rapides).
FACT_Sales:
LOAD * FROM [$(vLib)$(vQvdTrf)fact_sales.qvd] (qvd);

DIM_Customer:
LOAD * FROM [$(vLib)$(vQvdTrf)dim_customer.qvd] (qvd);

DIM_Product:
LOAD * FROM [$(vLib)$(vQvdTrf)dim_product.qvd] (qvd);

DIM_Calendar:
LOAD * FROM [$(vLib)$(vQvdTrf)dim_calendar.qvd] (qvd);

// Champ technique inutile pour les utilisateurs : retiré du modèle.
DROP FIELD _IngestRunId;

// Fraîcheur des données, affichée dans l'app (bandeau « Données au … »).
APP_Freshness:
LOAD
    '$(vRunId)'               AS [Exécution Airflow],
    Timestamp(Now(1))         AS [Publié le],
    '$(vScriptVersion)'       AS [Version du script]
AUTOGENERATE 1;

///$tab Expressions
// Expressions centralisées : une seule définition, réutilisée dans toutes les feuilles.
// Le « @ » est remplacé par « $ » pour que le script ne développe pas l'expression au chargement.
SET vCA          = Sum(Revenue);
SET vMarge       = Sum(Margin);
LET vMargePct    = 'Sum(Margin) / Sum(Revenue)';
SET vNbCommandes = Count(DISTINCT OrderID);
LET vPanierMoyen = 'Sum(Revenue) / Count(DISTINCT OrderID)';
LET vCA_Jour     = Replace('Sum({<OrderDate={"@(=Date(Max(OrderDate)))"}>} Revenue)', '@', '$');
LET vCA_J7       = Replace('Sum({<OrderDate={">=@(=Date(Max(OrderDate)-6))<=@(=Date(Max(OrderDate)))"}>} Revenue)', '@', '$');
LET vCA_J7_Prec  = Replace('Sum({<OrderDate={">=@(=Date(Max(OrderDate)-13))<=@(=Date(Max(OrderDate)-7))"}>} Revenue)', '@', '$');

///$tab DQ
LET vDQ_Rows = NoOfRows('FACT_Sales');
TRACE DQ|app=03_Sales_Operations|run_id=$(vRunId)|rows=$(vDQ_Rows);
